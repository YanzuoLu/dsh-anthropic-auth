  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "anthropic",
    "claude",
    "oauth"
  ],
  "license": "MIT",
  "author": "Yanzuo Lu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanzuoLu/dsh-anthropic-auth.git"
  },
  "homepage": "https://github.com/YanzuoLu/dsh-anthropic-auth#readme",
  "bugs": {
    "url": "https://github.com/YanzuoLu/dsh-anthropic-auth/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml"
  ],
