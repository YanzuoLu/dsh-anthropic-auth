{
  "name": "dsh-anthropic-auth",
  "version": "0.2.0",
  "description": "Claude OAuth request compatibility and native Anthropic login settings for DeepSeek Harness",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "anthropic",
    "claude",
    "oauth"
  ],
  "license": "MIT",
  "author": "Yanzuo Lu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanzuoLu/dsh-anthropic-auth.git"
  },
  "homepage": "https://github.com/YanzuoLu/dsh-anthropic-auth#readme",
  "bugs": {
    "url": "https://github.com/YanzuoLu/dsh-anthropic-auth/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "login-entry.js",
    "lib",
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-primitives"]
    }
  },
  "scripts": { "build": "node scripts/build.mjs" },
  "engines": { "node": ">=22.15" },
  "devDependencies": { "esbuild": "0.25.12" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-authorization": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@earendil-works/pi-ai": "^0.87.1"
  }
}
